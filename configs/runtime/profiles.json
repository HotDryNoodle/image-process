        "scale": {"factory": "videoscale", "properties": {"n-threads": 0}},
        "caps": {
          "format": "I420",
          "width": 1024,
          "height": 1024,
          "framerate_num": 30,
          "framerate_den": 1
        },
        "encoder": {
          "factory": "x264enc",
          "properties": {
            "bitrate": 6000,
            "speed-preset": "veryfast",
            "tune": "zerolatency",
            "key-int-max": 30,
            "threads": 0,
            "byte-stream": false
          }
        },
        "parser": {"factory": "h264parse", "properties": {"config-interval": -1}},
        "muxer": {"factory": "mp4mux", "properties": {"faststart": true}}
      },
      "max_frames": 64,
      "timeout_sec": 300
