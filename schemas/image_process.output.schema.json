{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://satellite.local/schemas/image_process.output.schema.json",
  "title": "ImageProcessResult",
  "$defs": {
    "fileArtifact": {
      "type": "object",
      "required": ["path", "media_type", "size_bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "media_type": {"type": "string", "minLength": 1},
        "size_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["schema_version", "status", "request_id", "runtime_profile", "pipeline_plan"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "status": {"enum": ["dry_run", "completed", "no_result", "failed"]},
    "request_id": {"type": "string"},
    "trace_id": {"type": ["string", "null"]},
    "runtime_profile": {"type": "string"},
    "pipeline_plan": {"type": "object"},
    "frame_count": {"type": "integer", "minimum": 0},
    "artifact": {"$ref": "#/$defs/fileArtifact"},
    "meta_artifact": {"$ref": "#/$defs/fileArtifact"},
    "provenance": {"type": "object"},
    "resource_usage": {
      "type": "object",
      "required": ["wall_time_seconds", "cpu_time_seconds", "average_cpu_percent", "peak_observed_cpu_percent", "peak_rss_bytes", "input_bytes", "sampling"],
      "properties": {
        "wall_time_seconds": {"type": "number", "minimum": 0},
        "cpu_time_seconds": {"type": "number", "minimum": 0},
        "average_cpu_percent": {"type": "number", "minimum": 0},
        "peak_observed_cpu_percent": {"type": "number", "minimum": 0},
        "peak_rss_bytes": {"type": "integer", "minimum": 1},
        "input_bytes": {"type": "integer", "minimum": 0},
        "video_output_bytes": {"type": "integer", "minimum": 1},
        "metadata_output_bytes": {"type": "integer", "minimum": 1},
        "frames_per_second": {"type": "number", "minimum": 0},
        "sampling": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
