{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HotDryNoodle/image-process/schemas/runtime_manifest.schema.json",
  "title": "image-process runtime manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "component",
    "component_version",
    "component_revision",
    "meta_abi",
    "plugins",
    "source_provenance_sha256",
    "build_features"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "component": {"const": "image-process"},
    "component_version": {"type": "string", "minLength": 1},
    "component_revision": {"type": "string", "minLength": 1},
    "meta_abi": {"const": "image-process.gst-meta.v1"},
    "plugins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["plugin", "factories"],
        "properties": {
          "plugin": {"type": "string", "minLength": 1},
          "factories": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "source_provenance_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "build_features": {
      "type": "object",
      "additionalProperties": {"type": "boolean"}
    }
  }
}
