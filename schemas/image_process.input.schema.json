{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://satellite.local/schemas/image_process.input.schema.json",
  "title": "ImageProcessRequest",
  "type": "object",
  "required": ["schema_version", "request_id", "acquisition_mode", "sensor", "input", "processing"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "request_id": {"type": "string", "minLength": 1},
    "trace_id": {"type": "string", "minLength": 1},
    "acquisition_mode": {"enum": ["pushbroom", "stare"]},
    "sensor": {
      "type": "object",
      "required": ["id"],
      "properties": {"id": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "required": ["artifact_ref", "media_type"],
      "properties": {
        "artifact_ref": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "media_type": {"type": "string", "minLength": 1},
        "size_bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "processing": {
      "type": "object",
      "required": ["runtime_profile"],
      "properties": {
        "runtime_profile": {"type": "string", "minLength": 1},
        "max_frames": {"type": "integer", "minimum": 1, "maximum": 4096}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
